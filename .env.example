# Local Postgres (no password over the unix socket for the current OS user). Nothing leaves this machine.
DATABASE_URL=postgresql:///spelling?host=/var/run/postgresql
JWT_SECRET=change-me-to-a-long-random-string
PORT=4100
# Comma separated origins allowed to call the API (frontend URL)
CORS_ORIGIN=http://localhost:3100
# Artwork + rendered pages, shared with the OCR worker (same path in 02.-Spelling_OCR/.env)
STORAGE_DIR=../storage
