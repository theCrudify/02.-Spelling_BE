{
  "name": "spelling-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
